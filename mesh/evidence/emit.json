    "script": "import copy\nimport hashlib\nimport importlib.util\nimport json\nimport os\nfrom pathlib import Path\nimport subprocess\n\nroot = Path.cwd()\npath = root / 'plugin/makoto2/hook.py'\nspec = importlib.util.spec_from_file_location('emit_hook', path)\nhook = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(hook)\nfinding = {'row': 'r1', 'message': 'm', 'objects': ['x']}\nreason = 'makoto r1: m'\nobservations = []\nevents = [None, {}, {'hook_event_name': None}, {'hook_event_name': ''}]\nevents += [{'hook_event_name': name} for name in ('PreToolUse', 'Stop', 'SubagentStop', 'PostToolUse', 'PostToolUseFailure', 'UserPromptSubmit', 'Unknown')]\nfor event in events:\n    for decision in (None, finding):\n        before = copy.deepcopy((event, decision))\n        name = event.get('hook_event_name') if event is not None else None\n        expected = {}\n        relation = 'no_finding:silent' if decision is None else 'other_event:silent'\n        if decision is not None and name == 'PreToolUse':\n            expected = {'hookSpecificOutput': {'hookEventName': name, 'permissionDecision': 'deny', 'permissionDecisionReason': reason}}\n            relation = 'pre_finding:deny'\n        elif decision is not None and name in ('Stop', 'SubagentStop'):\n            expected = {'decision': 'block', 'reason': reason}\n            relation = 'stop_finding:block' if name == 'Stop' else 'substop_finding:block'\n        observed = hook.d_out(event, decision)\n        assert observed == expected, (event, observed, expected)\n        assert before == (event, decision), 'input mutated'\n        assert json.loads(json.dumps(observed)) == observed\n        observations.append({'case': f'{name!r}/{\"finding\" if decision else \"none\"}', 'relation': relation, 'inputs': {'event': event, 'finding': decision}, 'expected': expected, 'observed': observed, 'inputs_unchanged': True, 'json_round_trip': True, 'result': 'pass'})\n# Preserve finding text exactly, including characters requiring JSON escaping.\nspecial = {'row': 'r\\\"\\\\\\n雪', 'message': 'm\\n\\t\\\"\\\\☃', 'objects': []}\nfor name in ('PreToolUse', 'Stop', 'SubagentStop'):\n    event = {'hook_event_name': name, 'unrelated': {'nested': [1, None]}}\n    observed = hook.d_out(event, special)\n    actual_reason = observed['hookSpecificOutput']['permissionDecisionReason'] if name == 'PreToolUse' else observed['reason']\n    expected_reason = f\"makoto {special['row']}: {special['message']}\"\n    assert actual_reason == expected_reason\n    assert json.loads(json.dumps(observed)) == observed\n    observations.append({'case': name + '/escaped-text', 'inputs': {'event': event, 'finding': special}, 'expected_reason': expected_reason, 'observed': observed, 'json_round_trip': True, 'result': 'pass'})\nchecks = []\nfor command in ('PYTHONDONTWRITEBYTECODE=1 python3 mesh/check.py --task emit', 'PYTHONDONTWRITEBYTECODE=1 python3 tests/test_hook.py'):\n    proc = subprocess.run(command, shell=True, text=True, capture_output=True)\n    checks.append({'command': command, 'exit_code': proc.returncode, 'stdout': proc.stdout, 'stderr': proc.stderr})\n    assert proc.returncode == 0, checks[-1]\npins = {name: hashlib.sha256((root / name).read_bytes()).hexdigest() for name in ('plugin/makoto2/hook.py', 'mesh/REQUIREMENTS.tsv', 'mesh/CONSTRAINTS.tsv', 'mesh/reference/docs-def-README.md', 'mesh/check.py', 'tests/test_hook.py')}\nevidence = {'task': 'emit', 'requirement': 'output', 'candidate': 'plugin/makoto2/hook.py:d_out', 'selected_input_digest': pins['plugin/makoto2/hook.py'], 'digest_scope': 'SHA-256 of complete plugin/makoto2/hook.py bytes; evidence is an output, not self-pinned', 'source_pins': pins, 'observations': observations, 'checks': checks, 'result': 'pass', 'present': sorted(set(o['relation'] for o in observations if 'relation' in o)), 'absent': [], 'external': [], 'scope': 'Direct local emit probes cover every output requirement relation, optional decoded events, JSON serialization, and input preservation. The required checker certifies declarative model shape only. Other receipts pin their own inputs and require remeasurement after this shared-file change; this evidence does not certify live installation or external outcomes.', 'reproduction': {'command': 'PYTHONDONTWRITEBYTECODE=1 python3 /tmp/makoto-emit-evidence.py', 'script': Path(__file__).read_text()}}\n(root / 'mesh/evidence/emit.json').write_text(json.dumps(evidence, indent=2, ensure_ascii=False) + '\\n')\nprint(f'{len(observations)} emit probes passed; model check and hook assertions passed')\n"
