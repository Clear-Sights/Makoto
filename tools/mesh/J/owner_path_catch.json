{
 "files": {
  "makoto.toml": "owner_paths = [\"config.env\", \".claude/\"]\n",
  "config.env": "API_BASE=https://api.example.com\nTIMEOUT=30\n",
  "config.env.bak": "API_BASE=https://old.example.com\n"
 },
 "events": [
  {
   "hook_event_name": "PreToolUse",
   "tool_name": "Bash",
   "tool_input": {
    "command": "rm -f config.env",
    "description": "Remove stale env file"
   }
  }
 ]
}
