{
  "scope": "finite typed decisions, not efficacy",
  "rules": {
    "C9": {
      "classes": [
        "bill"
      ],
      "actions": [
        "aggregate_usage",
        "all_token_types",
        "dedupe_ids",
        "step_window",
        "unknown_usage"
      ],
      "forbidden": [
        "last_segment",
        "omit_cache",
        "double_count"
      ]
    },
    "C17": {
      "classes": [
        "launch"
      ],
      "actions": [
        "asymmetry_plan",
        "model_effort_return",
        "cheapest_checked_leaf",
        "failed_check_escalation",
        "first_framing",
        "capability_match"
      ],
      "forbidden": [
        "blind_escalation",
        "multi_framing_first",
        "missing_tool_dispatch"
      ]
    },
    "C1": {
      "classes": [
        "handoff"
      ],
      "actions": [
        "actual_fresh_context",
        "host_limit_continuation"
      ],
      "forbidden": [
        "announce_only_handoff"
      ]
    },
    "C19": {
      "classes": [
        "continuation"
      ],
      "actions": [
        "chain_on_success",
        "preserve_exits",
        "no_op_end"
      ],
      "forbidden": [
        "chain_after_failure",
        "noop_reread"
      ]
    },
    "C13": {
      "classes": [
        "suite_timing"
      ],
      "actions": [
        "suite_at_done"
      ],
      "forbidden": [
        "full_suite_every_launch"
      ]
    },
    "C20": {
      "classes": [
        "verdict_read"
      ],
      "actions": [
        "verdict_carries_claims",
        "deterministic_crosscheck",
        "inspect_unchecked"
      ],
      "forbidden": [
        "bare_verdict_only"
      ]
    },
    "C4": {
      "classes": [
        "prior_art"
      ],
      "actions": [
        "standard_algorithm",
        "matching_output"
      ],
      "forbidden": [
        "invent_first"
      ]
    },
    "C8": {
      "classes": [
        "headless_inputs"
      ],
      "actions": [
        "bounded_environment",
        "bounded_context",
        "bounded_tools"
      ],
      "forbidden": [
        "inherit_session"
      ]
    },
    "C10": {
      "classes": [
        "standing_authority"
      ],
      "actions": [
        "standing_approval",
        "stated_default"
      ],
      "forbidden": [
        "repeated_permission_wait"
      ]
    },
    "C11": {
      "classes": [
        "repeated_guard"
      ],
      "actions": [
        "action_guard",
        "two_sided_guard"
      ],
      "forbidden": [
        "reminder_only"
      ]
    },
    "C6": {
      "classes": [
        "loop_cost"
      ],
      "actions": [
        "whole_loop_cost",
        "one_brief_one_verification"
      ],
      "forbidden": [
        "worker_only_cost"
      ]
    }
  }
}
